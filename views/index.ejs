<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kadopay — Premium Gift Cards</title>
    <meta name="description" content="Kadopay is a premium marketplace for digital gift cards from the world's best brands." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="min-h-screen bg-ink-50">
      <%- include('partials/header') %>

      <main class="pb-20 lg:pb-0">
        <!-- Hero -->
        <section class="relative overflow-hidden bg-ink-950">
          <div class="absolute inset-0">
            <div class="absolute -left-40 top-0 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl"></div>
            <div class="absolute right-0 top-20 h-80 w-80 rounded-full bg-gold-500/10 blur-3xl"></div>
            <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-brand-700/20 blur-3xl"></div>
          </div>
          <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>

          <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
            <div class="mx-auto max-w-3xl text-center">
              <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm font-medium text-brand-300 backdrop-blur animate-fade-in">
                <%- icon('zap', { size: 14, className: 'text-brand-300' }) %>
                Instant digital delivery
              </div>
              <h1 class="font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl animate-fade-up">
                Gift cards from the<br />
                <span class="bg-gradient-to-r from-brand-400 via-brand-300 to-gold-400 bg-clip-text text-transparent">brands you love</span>
              </h1>
              <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-300 animate-fade-up" style="animation-delay: 60ms;">
                Shop premium digital gift cards from 200+ top brands. Pay less than face value, delivered instantly to your inbox.
              </p>
              <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row animate-fade-up" style="animation-delay: 120ms;">
                <a href="#catalog" class="group inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-all hover:bg-brand-400 hover:shadow-brand-500/40 active:scale-95">
                  <%- icon('gift', { size: 16, className: 'transition-transform group-hover:rotate-12' }) %>
                  Browse gift cards
                </a>
                <a href="#how-it-works" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/10 active:scale-95">
                  How it works
                </a>
              </div>
              <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-ink-400 animate-fade-up" style="animation-delay: 180ms;">
                <span class="inline-flex items-center gap-2"><%- icon('shield-check', { size: 16, className: 'text-brand-400' }) %> Secure checkout</span>
                <span class="inline-flex items-center gap-2"><%- icon('zap', { size: 16, className: 'text-brand-400' }) %> Instant delivery</span>
                <span class="inline-flex items-center gap-2"><%- icon('shield-check', { size: 16, className: 'text-brand-400' }) %> 200+ brands</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Featured carousel -->
        <section id="featured" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
          <div class="mb-6 flex items-end justify-between">
            <div>
              <div class="mb-2 inline-flex items-center gap-1.5 rounded-full bg-gold-50 px-3 py-1 text-xs font-semibold text-gold-700">
                <%- icon('star', { size: 14, fill: 'currentColor', className: 'fill-gold-500 text-gold-500' }) %>
                Featured
              </div>
              <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">Most loved this week</h2>
            </div>
            <div class="hidden gap-2 sm:flex">
              <button id="featured-scroll-left" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-ink-600 ring-1 ring-ink-200 transition-all hover:bg-ink-100 active:scale-95">
                <%- icon('chevron-left', { size: 20 }) %>
              </button>
              <button id="featured-scroll-right" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-ink-600 ring-1 ring-ink-200 transition-all hover:bg-ink-100 active:scale-95">
                <%- icon('chevron-right', { size: 20 }) %>
              </button>
            </div>
          </div>

          <div id="featured-scroll" class="no-scrollbar -mx-4 flex gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
            <% featured.forEach(function(brand) { %>
              <%
                const cards = brand.gift_cards || [];
                const minPrice = cards.length ? Math.min(...cards.map(c => c.price)) : 0;
                const maxDenom = cards.length ? Math.max(...cards.map(c => c.denomination)) : 0;
                const maxDiscount = cards.length ? Math.max(...cards.map(c => discountPercent(c.denomination, c.price))) : 0;
                const accent = brand.accent_color || '#0F172A';
                const accent2 = brand.accent_color_2 || '#334155';
              %>
              <a href="#catalog" class="group relative w-72 shrink-0 overflow-hidden rounded-2xl shadow-card ring-1 ring-ink-200/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover">
                <div class="relative h-44 p-5" style="background: linear-gradient(135deg, <%= accent %> 0%, <%= accent2 %> 100%);">
                  <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10"></div>
                  <div class="absolute -bottom-16 right-4 h-32 w-32 rounded-full bg-white/5"></div>
                  <div class="absolute right-6 top-6 h-14 w-14 rounded-full border border-white/10"></div>
                  <% if (maxDiscount > 0) { %>
                    <div class="absolute left-4 top-4 rounded-full bg-gold-500/90 px-2.5 py-1 text-xs font-bold text-ink-900 backdrop-blur">Up to <%= maxDiscount %>% off</div>
                  <% } %>
                  <div class="relative flex h-full flex-col justify-end">
                    <p class="text-xs font-medium uppercase tracking-widest text-white/60">Gift Card</p>
                    <h3 class="font-display text-2xl font-bold text-white drop-shadow-sm"><%= brand.name %></h3>
                  </div>
                </div>
                <div class="flex items-center justify-between bg-white p-4">
                  <div>
                    <p class="text-xs text-ink-400">From</p>
                    <p class="font-display text-lg font-bold text-ink-900"><%= formatCurrency(minPrice) %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-ink-400">Up to</p>
                    <p class="font-display text-lg font-bold text-ink-900"><%= formatCurrency(maxDenom) %></p>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </section>

        <!-- Catalog -->
        <section id="catalog" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
          <div class="mb-6">
            <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">Browse all gift cards</h2>
            <p id="catalog-count" class="mt-2 text-ink-500"><%= catalog.length %> brands · <%= catalog.reduce((s, b) => s + (b.gift_cards ? b.gift_cards.length : 0), 0) %> gift cards available</p>
          </div>

          <!-- Category pills -->
          <div class="mb-6">
            <div id="category-pills" class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-ink-900 text-white shadow-md" data-category="">All</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Entertainment"><%- icon('clapperboard', { size: 16 }) %> Entertainment</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Shopping"><%- icon('shopping-bag', { size: 16 }) %> Shopping</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Food & Drink"><%- icon('coffee', { size: 16 }) %> Food & Drink</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Gaming"><%- icon('gamepad-2', { size: 16 }) %> Gaming</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Travel"><%- icon('plane', { size: 16 }) %> Travel</button>
              <button class="category-pill shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition-all active:scale-95 bg-white text-ink-600 ring-1 ring-ink-200 hover:ring-ink-300 flex items-center gap-2" data-category="Fashion"><%- icon('shirt', { size: 16 }) %> Fashion</button>
            </div>
          </div>

          <!-- Filter bar -->
          <div class="mb-6">
            <div class="flex flex-col gap-4 rounded-2xl bg-white p-4 shadow-card ring-1 ring-ink-200/60 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-2">
                <span class="text-ink-500"><%- icon('sliders-horizontal', { size: 16 }) %></span>
                <span class="text-sm font-semibold text-ink-700">Filters</span>
                <span class="text-sm text-ink-400">·</span>
                <span id="filter-result-count" class="text-sm text-ink-500"><%= catalog.reduce((s, b) => s + (b.gift_cards ? b.gift_cards.length : 0), 0) %> cards</span>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <!-- On sale toggle -->
                <button id="sale-toggle" class="flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium transition-all active:scale-95 bg-ink-50 text-ink-500 ring-1 ring-ink-200 hover:bg-ink-100">
                  <div id="sale-checkbox" class="flex h-4 w-4 items-center justify-center rounded transition-colors bg-ink-300"></div>
                  On sale
                </button>
                <!-- Max price slider -->
                <div class="flex items-center gap-2 rounded-full bg-ink-50 px-3 py-2 ring-1 ring-ink-200">
                  <span class="text-sm font-medium text-ink-500">Max</span>
                  <input type="range" id="max-price-slider" min="10" max="500" step="10" value="500" class="h-1.5 w-24 cursor-pointer appearance-none rounded-full bg-ink-200 accent-brand-500" />
                  <span id="max-price-label" class="w-10 text-sm font-semibold text-ink-700">$500</span>
                </div>
                <!-- Sort dropdown -->
                <div class="relative">
                  <div class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-400"><%- icon('arrow-down-wide-narrow', { size: 16 }) %></div>
                  <select id="sort-select" class="cursor-pointer appearance-none rounded-full border-0 bg-ink-50 py-2 pl-9 pr-8 text-sm font-medium text-ink-700 ring-1 ring-ink-200 transition-colors hover:bg-ink-100 focus:outline-none focus:ring-2 focus:ring-brand-400">
                    <option value="popular">Most popular</option>
                    <option value="price-low">Price: low to high</option>
                    <option value="price-high">Price: high to low</option>
                    <option value="discount">Biggest discount</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Gift card grid -->
          <div id="gift-card-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            <% catalog.forEach(function(brand) { %>
              <%- include('partials/gift-card', { brand: brand, icon: icon, formatCurrency: formatCurrency, discountPercent: discountPercent }) %>
            <% }); %>
          </div>

          <!-- Empty state -->
          <div id="empty-state" class="flex flex-col items-center justify-center gap-3 rounded-2xl bg-white py-20 text-center shadow-card ring-1 ring-ink-200/60" style="display:none;">
            <p class="font-display text-lg font-bold text-ink-900">No gift cards found</p>
            <p class="text-sm text-ink-500">Try adjusting your filters or search query.</p>
            <button id="reset-filters-btn" class="mt-2 rounded-full bg-ink-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800">Reset filters</button>
          </div>
        </section>

        <!-- How it works -->
        <section id="how-it-works" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
          <div class="text-center">
            <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">How it works</h2>
            <p class="mx-auto mt-3 max-w-lg text-ink-500">Three simple steps from browsing to gifting. No accounts, no waiting.</p>
          </div>
          <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
            <div class="relative rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60">
              <div class="absolute right-6 top-6 font-display text-5xl font-extrabold text-ink-100">1</div>
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50"><%- icon('mouse-pointer-click', { size: 28, className: 'text-brand-600' }) %></div>
              <h3 class="mt-5 font-display text-lg font-bold text-ink-900">Pick your card</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">Browse 200+ brands and choose the denomination that fits your budget.</p>
            </div>
            <div class="relative rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60">
              <div class="absolute right-6 top-6 font-display text-5xl font-extrabold text-ink-100">2</div>
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50"><%- icon('gift', { size: 28, className: 'text-brand-600' }) %></div>
              <h3 class="mt-5 font-display text-lg font-bold text-ink-900">Checkout securely</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">Pay with confidence using our encrypted, PCI-compliant checkout.</p>
            </div>
            <div class="relative rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60">
              <div class="absolute right-6 top-6 font-display text-5xl font-extrabold text-ink-100">3</div>
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50"><%- icon('mail', { size: 28, className: 'text-brand-600' }) %></div>
              <h3 class="mt-5 font-display text-lg font-bold text-ink-900">Receive instantly</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">Your digital gift card is delivered to your inbox in seconds.</p>
            </div>
          </div>
        </section>
      </main>

      <%- include('partials/footer') %>
      <%- include('partials/cart-drawer') %>
      <%- include('partials/mobile-nav') %>
    </div>

    <!-- Gift card details modal -->
    <div id="card-modal-backdrop" class="fixed inset-0 z-[60] flex items-center justify-center bg-ink-950/50 backdrop-blur-sm p-4 transition-opacity duration-300 opacity-0 pointer-events-none">
      <div id="card-modal" class="kadopay-purchase-modal relative w-full max-w-5xl max-h-[92vh] overflow-y-auto rounded-[28px] bg-white shadow-2xl transition-all duration-300 scale-95 opacity-0">
        <button id="card-modal-close" class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/80 text-ink-500 backdrop-blur transition-colors hover:bg-ink-100 hover:text-ink-700">
          <%- icon('x', { size: 20 }) %>
        </button>
        <div id="card-modal-body"></div>
      </div>
    </div>

    <!-- Cart item template (hidden, cloned by JS) -->
    <template id="cart-item-template">
      <div class="cart-row flex gap-3 rounded-xl border border-ink-100 p-3 animate-fade-in">
        <div class="cart-card-visual relative flex h-20 w-28 shrink-0 flex-col justify-between overflow-hidden rounded-lg p-2.5">
          <div class="absolute -right-4 -top-4 h-12 w-12 rounded-full bg-white/10"></div>
          <p class="relative text-[10px] font-medium uppercase tracking-wider text-white/60">Gift Card</p>
          <p class="cart-brand-name relative font-display text-xs font-bold leading-tight text-white"></p>
          <p class="cart-denom relative text-sm font-bold text-white"></p>
        </div>
        <div class="flex flex-1 flex-col">
          <div class="flex items-start justify-between">
            <div>
              <p class="cart-brand-title font-semibold text-ink-900"></p>
              <p class="cart-denom-label text-xs text-ink-500"></p>
            </div>
            <button class="cart-remove flex h-8 w-8 items-center justify-center rounded-full text-ink-400 transition-colors hover:bg-red-50 hover:text-red-500"><%- icon('trash-2', { size: 16 }) %></button>
          </div>
          <div class="mt-auto flex items-center justify-between">
            <div class="flex items-center gap-1 rounded-full bg-ink-100 p-0.5">
              <button class="cart-dec flex h-7 w-7 items-center justify-center rounded-full text-ink-600 transition-colors hover:bg-white"><%- icon('minus', { size: 14 }) %></button>
              <span class="cart-qty w-7 text-center text-sm font-semibold text-ink-800"></span>
              <button class="cart-inc flex h-7 w-7 items-center justify-center rounded-full text-ink-600 transition-colors hover:bg-white"><%- icon('plus', { size: 14 }) %></button>
            </div>
            <span class="cart-line-total font-display text-sm font-bold text-ink-900"></span>
          </div>
        </div>
      </div>
    </template>

    <!-- Gift card template (for client-side re-rendering after filter) -->
    <template id="gift-card-template">
      <div class="gift-card-item group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-ink-200/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover hover:ring-ink-300/60">
        <div class="card-visual relative h-40 overflow-hidden p-5">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/10"></div>
          <div class="absolute -bottom-12 -right-4 h-28 w-28 rounded-full bg-white/5"></div>
          <div class="absolute right-4 top-4 h-16 w-16 rounded-full border border-white/10"></div>
          <div class="absolute right-5 top-5 flex h-8 w-11 items-center justify-center rounded-md bg-white/15 backdrop-blur"><div class="h-5 w-8 rounded-sm border border-white/30"></div></div>
          <div class="relative flex h-full flex-col justify-between">
            <div>
              <p class="text-xs font-medium uppercase tracking-widest text-white/60">Gift Card</p>
              <h3 class="card-name mt-1 font-display text-2xl font-bold leading-tight text-white drop-shadow-sm"></h3>
            </div>
            <div class="flex items-end justify-between">
              <span class="card-category text-sm font-medium text-white/80"></span>
              <span class="card-denom-display font-display text-2xl font-extrabold text-white"></span>
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-4">
          <p class="card-desc line-clamp-2 text-sm leading-relaxed text-ink-500 min-h-[2.5rem]"></p>
          <div class="card-denoms mt-3 flex flex-wrap gap-1.5"></div>
          <div class="mt-4 flex items-center justify-between gap-3">
            <div class="flex items-baseline gap-2">
              <p class="card-price-strike text-sm text-ink-400 line-through"></p>
              <p class="card-price-display font-display text-lg font-bold text-ink-900"></p>
            </div>
            <button class="card-add-btn flex items-center gap-1.5 rounded-full px-4 py-2.5 text-sm font-semibold transition-all active:scale-95 bg-ink-900 text-white hover:bg-ink-800">
              <span class="card-add-icon"><%- icon('plus', { size: 16 }) %></span>
              <span class="card-add-label">Add</span>
            </button>
          </div>
          <div class="card-savings mt-3 flex items-center gap-1.5 rounded-lg bg-brand-50 px-2.5 py-1.5 text-xs font-medium text-brand-700" style="display:none;">
            <%- icon('trending-down', { size: 14 }) %>
            <span class="card-savings-text"></span>
          </div>
        </div>
      </div>
    </template>

    <script>
      window.__CATALOG__ = <%- JSON.stringify(catalog) %>;
    </script>
    <script type="module" src="/js/app.js"></script>
  </body>
</html>
