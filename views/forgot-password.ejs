<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — Kadopay</title>
    <meta name="description" content="Reset your Kadopay account password." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <div class="min-h-screen bg-ink-50">
      <%- include('partials/header') %>

      <main class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
          <!-- Back link -->
          <a href="/login" class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 transition-colors hover:text-ink-700">
            <%- icon('arrow-left', { size: 16 }) %>
            Back to login
          </a>

          <!-- Progress indicator -->
          <div id="reset-progress" class="mb-6">
            <div class="flex items-center justify-between">
              <div class="reset-progress-step active" data-step="1">
                <div class="reset-progress-dot">1</div>
                <span class="reset-progress-label">Email</span>
              </div>
              <div class="reset-progress-line"></div>
              <div class="reset-progress-step" data-step="2">
                <div class="reset-progress-dot">2</div>
                <span class="reset-progress-label">Verify email</span>
              </div>
              <div class="reset-progress-line"></div>
              <div class="reset-progress-step" data-step="3">
                <div class="reset-progress-dot">3</div>
                <span class="reset-progress-label">Phone</span>
              </div>
              <div class="reset-progress-line"></div>
              <div class="reset-progress-step" data-step="4">
                <div class="reset-progress-dot">4</div>
                <span class="reset-progress-label">Verify phone</span>
              </div>
              <div class="reset-progress-line"></div>
              <div class="reset-progress-step" data-step="5">
                <div class="reset-progress-dot">5</div>
                <span class="reset-progress-label">New password</span>
              </div>
            </div>
          </div>

          <!-- Step 1: Enter email -->
          <div id="reset-step-email" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up">
            <div class="mb-8 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50">
                <%- icon('key-round', { size: 24, className: 'text-brand-600' }) %>
              </div>
              <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Forgot password?</h1>
              <p class="mt-1.5 text-sm text-ink-500">Enter your registered email and we'll send you a verification code.</p>
            </div>

            <form id="reset-email-form" novalidate>
              <div class="auth-field">
                <label for="reset-email" class="auth-label">Email address</label>
                <div class="auth-input-wrap">
                  <span class="auth-input-icon"><%- icon('mail', { size: 16, className: 'text-ink-400' }) %></span>
                  <input
                    type="email"
                    id="reset-email"
                    name="email"
                    placeholder="you@example.com"
                    autocomplete="email"
                    class="auth-input pl-10"
                    required
                  />
                </div>
                <p class="auth-error" data-error-for="reset-email"></p>
              </div>

              <button type="submit" id="reset-email-submit" class="auth-submit-btn">
                <span class="auth-btn-text">Send code</span>
                <span class="auth-btn-spinner" style="display:none;">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                </span>
              </button>
            </form>
          </div>

          <!-- Step 2: Verify email OTP -->
          <div id="reset-step-email-otp" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up" style="display:none;">
            <div class="mb-8 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50">
                <%- icon('mail', { size: 24, className: 'text-brand-600' }) %>
              </div>
              <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Verify your email</h1>
              <p class="mt-1.5 text-sm text-ink-500">Enter the 6-digit code sent to<br /><span id="reset-email-display" class="font-semibold text-ink-700"></span></p>
            </div>

            <form id="reset-email-otp-form" novalidate>
              <div class="auth-field">
                <label class="auth-label">Verification code</label>
                <div class="flex justify-between gap-2" id="reset-email-otp-inputs">
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="0" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="1" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="2" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="3" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="4" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-reseotp="5" inputmode="numeric" />
                </div>
                <p class="auth-error" data-error-for="reset-email-otp"></p>
                <p class="mt-2 text-center text-xs text-ink-400">
                  Didn't receive a code?
                  <button type="button" id="reset-email-resend" class="font-medium text-brand-600 hover:text-brand-700" disabled>Resend code in 60s</button>
                </p>
              </div>

              <button type="submit" id="reset-email-otp-submit" class="auth-submit-btn">
                <span class="auth-btn-text">Verify code</span>
                <span class="auth-btn-spinner" style="display:none;">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                </span>
              </button>
            </form>
          </div>

          <!-- Step 3: Enter phone number -->
          <div id="reset-step-phone" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up" style="display:none;">
            <div class="mb-8 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50">
                <%- icon('phone', { size: 24, className: 'text-brand-600' }) %>
              </div>
              <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Verify your phone</h1>
              <p class="mt-1.5 text-sm text-ink-500">Enter the phone number associated with your Kadopay account.</p>
            </div>

            <form id="reset-phone-form" novalidate>
              <!-- Country -->
              <div class="auth-field">
                <label for="reset-country" class="auth-label">Country</label>
                <div class="country-dropdown" id="reset-country-wrap">
                  <button type="button" id="reset-country" class="country-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span class="auth-input-icon"><%- icon('globe', { size: 16, className: 'text-ink-400' }) %></span>
                    <span class="country-trigger-text" id="reset-country-text">Select your country</span>
                    <span class="auth-select-chevron"><%- icon('chevron-down', { size: 14, className: 'text-ink-400' }) %></span>
                  </button>
                  <input type="hidden" id="reset-country-value" name="country" value="" />
                  <div class="country-menu" id="reset-country-menu" role="listbox">
                    <div class="country-search-wrap">
                      <span class="country-search-icon"><%- icon('search', { size: 14, className: 'text-ink-400' }) %></span>
                      <input type="text" class="country-search" id="reset-country-search" placeholder="Search country or code…" autocomplete="off" />
                    </div>
                    <div class="country-options" id="reset-country-options"></div>
                  </div>
                </div>
                <p class="auth-error" data-error-for="reset-country"></p>
              </div>

              <!-- Phone number -->
              <div class="auth-field">
                <label for="reset-phone" class="auth-label">Phone number</label>
                <div class="flex gap-2">
                  <div class="auth-input-wrap shrink-0" style="width:7rem;">
                    <span class="auth-input-icon"><%- icon('globe', { size: 16, className: 'text-ink-400' }) %></span>
                    <input
                      type="text"
                      id="reset-dial-code"
                      name="dialCode"
                      placeholder="+1"
                      autocomplete="tel-country-code"
                      class="auth-input pl-10 pr-2 text-center"
                      value="+1"
                      required
                    />
                  </div>
                  <div class="auth-input-wrap flex-1">
                    <span class="auth-input-icon"><%- icon('phone', { size: 16, className: 'text-ink-400' }) %></span>
                    <input
                      type="tel"
                      id="reset-phone"
                      name="phone"
                      placeholder="555 123 4567"
                      autocomplete="tel-national"
                      class="auth-input pl-10"
                      required
                    />
                  </div>
                </div>
                <p class="auth-error" data-error-for="reset-dial-code"></p>
                <p class="auth-error" data-error-for="reset-phone"></p>
                <p class="mt-1.5 text-xs text-ink-400">We'll send a verification code by SMS to this number.</p>
              </div>

              <button type="submit" id="reset-phone-submit" class="auth-submit-btn">
                <span class="auth-btn-text">Send SMS code</span>
                <span class="auth-btn-spinner" style="display:none;">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                </span>
              </button>
            </form>
          </div>

          <!-- Step 4: Verify phone OTP -->
          <div id="reset-step-phone-otp" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up" style="display:none;">
            <div class="mb-8 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50">
                <%- icon('phone', { size: 24, className: 'text-brand-600' }) %>
              </div>
              <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Verify your phone</h1>
              <p class="mt-1.5 text-sm text-ink-500">Enter the 6-digit code sent by SMS to<br /><span id="reset-phone-display" class="font-semibold text-ink-700"></span></p>
            </div>

            <form id="reset-phone-otp-form" novalidate>
              <div class="auth-field">
                <label class="auth-label">Verification code</label>
                <div class="flex justify-between gap-2" id="reset-phone-otp-inputs">
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="0" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="1" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="2" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="3" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="4" inputmode="numeric" />
                  <input type="text" maxlength="1" class="auth-otp-input" data-respotp="5" inputmode="numeric" />
                </div>
                <p class="auth-error" data-error-for="reset-phone-otp"></p>
                <p class="mt-2 text-center text-xs text-ink-400">
                  Didn't receive a code?
                  <button type="button" id="reset-phone-resend" class="font-medium text-brand-600 hover:text-brand-700" disabled>Resend code in 60s</button>
                </p>
              </div>

              <button type="submit" id="reset-phone-otp-submit" class="auth-submit-btn">
                <span class="auth-btn-text">Verify code</span>
                <span class="auth-btn-spinner" style="display:none;">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                </span>
              </button>
            </form>
          </div>

          <!-- Step 5: Change password -->
          <div id="reset-step-password" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up" style="display:none;">
            <div class="mb-8 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50">
                <%- icon('lock', { size: 24, className: 'text-brand-600' }) %>
              </div>
              <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Set a new password</h1>
              <p class="mt-1.5 text-sm text-ink-500">Choose a strong password for your Kadopay account.</p>
            </div>

            <form id="reset-password-form" novalidate>
              <div class="auth-field">
                <label for="reset-new-password" class="auth-label">New password</label>
                <div class="auth-input-wrap">
                  <span class="auth-input-icon"><%- icon('lock', { size: 16, className: 'text-ink-400' }) %></span>
                  <input
                    type="password"
                    id="reset-new-password"
                    name="newPassword"
                    placeholder="At least 8 characters"
                    autocomplete="new-password"
                    class="auth-input pl-10 pr-10"
                    required
                  />
                  <button type="button" class="auth-toggle-password" data-toggle="reset-new-password" aria-label="Toggle password visibility">
                    <%- icon('eye-off', { size: 16, className: 'text-ink-400' }) %>
                  </button>
                </div>
                <div class="auth-strength">
                  <div class="auth-strength-bar"></div>
                  <div class="auth-strength-bar"></div>
                  <div class="auth-strength-bar"></div>
                </div>
                <p class="auth-strength-label"></p>
                <p class="auth-error" data-error-for="reset-new-password"></p>
              </div>

              <div class="auth-field">
                <label for="reset-confirm-password" class="auth-label">Confirm new password</label>
                <div class="auth-input-wrap">
                  <span class="auth-input-icon"><%- icon('lock', { size: 16, className: 'text-ink-400' }) %></span>
                  <input
                    type="password"
                    id="reset-confirm-password"
                    name="confirmPassword"
                    placeholder="Re-enter your new password"
                    autocomplete="new-password"
                    class="auth-input pl-10 pr-10"
                    required
                  />
                  <button type="button" class="auth-toggle-password" data-toggle="reset-confirm-password" aria-label="Toggle password visibility">
                    <%- icon('eye-off', { size: 16, className: 'text-ink-400' }) %>
                  </button>
                </div>
                <p class="auth-error" data-error-for="reset-confirm-password"></p>
              </div>

              <!-- Password requirements -->
              <div class="reset-password-requirements">
                <p class="reset-req-title">Password requirements:</p>
                <ul class="reset-req-list">
                  <li data-req="length">At least 8 characters</li>
                  <li data-req="upper">One uppercase letter</li>
                  <li data-req="lower">One lowercase letter</li>
                  <li data-req="number">One number</li>
                </ul>
              </div>

              <button type="submit" id="reset-password-submit" class="auth-submit-btn">
                <span class="auth-btn-text">Change password</span>
                <span class="auth-btn-spinner" style="display:none;">
                  <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                </span>
              </button>
            </form>
          </div>

          <!-- Step 6: Success -->
          <div id="reset-step-success" class="rounded-2xl bg-white p-8 shadow-card ring-1 ring-ink-200/60 animate-fade-up text-center" style="display:none;">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand-50">
              <%- icon('check-circle-2', { size: 36, className: 'text-brand-500' }) %>
            </div>
            <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink-900">Password changed!</h1>
            <p class="mt-2 text-sm text-ink-500">Your Kadopay password has been updated successfully. You can now log in with your new password.</p>
            <a href="/login" class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-ink-800 active:scale-95">
              <%- icon('arrow-right', { size: 16 }) %>
              Back to login
            </a>
          </div>

          <!-- Trust note -->
          <div class="mt-6 flex items-center justify-center gap-2 text-xs text-ink-400">
            <%- icon('shield-check', { size: 14, className: 'text-brand-500' }) %>
            Your data is protected with 256-bit SSL encryption
          </div>
        </div>
      </main>

      <%- include('partials/footer') %>
      <%- include('partials/mobile-nav') %>
    </div>

    <script src="/js/countries.js"></script>
    <script src="/js/forgot-password.js"></script>
  </body>
</html>
