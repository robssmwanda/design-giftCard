<%
  const accent = brand.accent_color || '#0F172A';
  const accent2 = brand.accent_color_2 || '#334155';
  const cards = brand.gift_cards || [];
  const firstCard = cards[0] || null;
  const discount = firstCard ? discountPercent(firstCard.denomination, firstCard.price) : 0;
%>
<div class="gift-card-item group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-ink-200/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover hover:ring-ink-300/60" data-brand-id="<%= brand.id %>" data-brand-name="<%= brand.name %>" data-brand-slug="<%= brand.slug %>" data-accent="<%= accent %>" data-accent2="<%= accent2 %>">
  <!-- Card visual -->
  <div class="relative h-40 overflow-hidden p-5" style="background: linear-gradient(135deg, <%= accent %> 0%, <%= accent2 %> 100%);">
    <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/10"></div>
    <div class="absolute -bottom-12 -right-4 h-28 w-28 rounded-full bg-white/5"></div>
    <div class="absolute right-4 top-4 h-16 w-16 rounded-full border border-white/10"></div>

    <!-- Chip -->
    <div class="absolute right-5 top-5 flex h-8 w-11 items-center justify-center rounded-md bg-white/15 backdrop-blur">
      <div class="h-5 w-8 rounded-sm border border-white/30"></div>
    </div>

    <div class="relative flex h-full flex-col justify-between">
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-white/60">Gift Card</p>
        <h3 class="mt-1 font-display text-2xl font-bold leading-tight text-white drop-shadow-sm"><%= brand.name %></h3>
      </div>
      <div class="flex items-end justify-between">
        <span class="text-sm font-medium text-white/80"><%= brand.category %></span>
        <span class="denomination-display font-display text-2xl font-extrabold text-white"><%= firstCard ? formatCurrency(firstCard.denomination) : '—' %></span>
      </div>
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-4">
    <p class="line-clamp-2 text-sm leading-relaxed text-ink-500 min-h-[2.5rem]"><%= brand.description || 'Premium digital gift card.' %></p>

    <!-- Denominations (max 15 displayed) -->
    <div class="mt-3 flex flex-wrap gap-1.5">
      <% cards.slice(0, 15).forEach(function(card, idx) { %>
        <% const cardDiscount = discountPercent(card.denomination, card.price); %>
        <button class="denom-btn relative rounded-lg px-2.5 py-1.5 text-xs font-semibold transition-all active:scale-95 <%= idx === 0 ? 'bg-ink-900 text-white shadow-sm' : 'bg-ink-100 text-ink-600 hover:bg-ink-200' %>" data-card-id="<%= card.id %>" data-denomination="<%= card.denomination %>" data-price="<%= card.price %>">
          <%= formatCurrency(card.denomination) %>
          <% if (cardDiscount > 0) { %>
            <span class="ml-1 text-[10px] font-bold <%= idx === 0 ? 'text-brand-400' : 'text-brand-600' %>">-<%= cardDiscount %>%</span>
          <% } %>
        </button>
      <% }); %>
    </div>

    <!-- Price + add -->
    <div class="mt-4 flex items-center justify-between gap-3">
      <div class="flex items-baseline gap-2">
        <p class="price-strike text-sm text-ink-400 line-through" style="<%= discount > 0 ? '' : 'display:none;' %>"><%= firstCard ? formatCurrency(firstCard.denomination) : '' %></p>
        <p class="price-display font-display text-lg font-bold text-ink-900"><%= firstCard ? formatCurrency(firstCard.price) : '—' %></p>
      </div>
      <button class="add-to-cart-btn flex items-center gap-1.5 rounded-full px-4 py-2.5 text-sm font-semibold transition-all active:scale-95 bg-ink-900 text-white hover:bg-ink-800" data-card-id="<%= firstCard ? firstCard.id : '' %>" data-denomination="<%= firstCard ? firstCard.denomination : '' %>" data-price="<%= firstCard ? firstCard.price : '' %>">
        <span class="add-icon"><%- icon('plus', { size: 16 }) %></span>
        <span class="add-label">Add</span>
      </button>
    </div>

    <!-- Savings badge -->
    <div class="savings-badge mt-3 flex items-center gap-1.5 rounded-lg bg-brand-50 px-2.5 py-1.5 text-xs font-medium text-brand-700" style="<%= discount > 0 ? '' : 'display:none;' %>">
      <%- icon('trending-down', { size: 14 }) %>
      <span class="savings-text">You save <%= firstCard ? formatCurrency(firstCard.denomination - firstCard.price) : '' %> (<%= discount %>%)</span>
    </div>
  </div>
</div>
