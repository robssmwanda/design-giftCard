<!-- Cart drawer backdrop -->
<div id="cart-backdrop" class="fixed inset-0 z-50 bg-ink-950/40 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- Cart drawer -->
<aside id="cart-drawer" class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md flex-col bg-white shadow-2xl transition-transform duration-300 translate-x-full">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-ink-100 px-5 py-4">
    <div class="flex items-center gap-2">
      <span class="text-ink-700"><%- icon('shopping-bag', { size: 20 }) %></span>
      <h2 id="cart-title" class="font-display text-lg font-bold text-ink-900">Your cart</h2>
      <span id="cart-count-pill" class="rounded-full bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-600" style="display:none;"></span>
    </div>
    <button id="close-cart-btn" class="flex h-9 w-9 items-center justify-center rounded-full text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-700">
      <%- icon('x', { size: 20 }) %>
    </button>
  </div>

  <!-- Content area -->
  <div id="cart-content" class="flex-1 overflow-y-auto"></div>

  <!-- Footer / actions -->
  <div id="cart-footer" class="border-t border-ink-100 p-5"></div>
</aside>
