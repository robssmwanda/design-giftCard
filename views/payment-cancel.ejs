<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Cancelled — Kadopay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="flex min-h-screen items-center justify-center bg-ink-50 px-4">
      <div class="w-full max-w-md rounded-2xl bg-white p-8 text-center shadow-card ring-1 ring-ink-200/60">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-red-50">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
        </div>
        <h1 class="mt-6 font-display text-2xl font-bold text-ink-900">Payment Cancelled</h1>
        <p class="mt-2 text-sm text-ink-500">Your payment was cancelled. You can try again at any time.</p>
        <a href="/cart" class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-800 active:scale-95">Return to cart</a>
      </div>
    </div>
  </body>
</html>
